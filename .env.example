# --- OpenAI ---
OPENAI_API_KEY=sk-...

# Generation LLM (same model for ALL conditions, controlled variable)
RAGAPP_LLM_MODEL=gpt-4o-mini
RAGAPP_LLM_TEMPERATURE=0.0

# LLM-as-judge for automated evaluation (may differ from generator)
RAGAPP_JUDGE_MODEL=gpt-4o

# Embeddings
RAGAPP_EMBEDDING_MODEL=text-embedding-3-small

# --- Qdrant ---
RAGAPP_QDRANT_URL=http://localhost:6333
RAGAPP_QDRANT_COLLECTION=university_policy_corpus

# --- PostgreSQL ---
RAGAPP_DATABASE_URL=postgresql+psycopg2://ragapp:ragapp@localhost:5432/ragapp

# --- Retrieval settings (shared across conditions, logged per run) ---
RAGAPP_TOP_K=5
RAGAPP_CANDIDATE_K=20
RAGAPP_CHUNK_SIZE=800
RAGAPP_CHUNK_OVERLAP=120

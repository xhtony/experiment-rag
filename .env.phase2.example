# Never commit real credentials. Phase 2 does not load the Phase 1 .env file.
OPENAI_API_KEY=
RAGAPP_LLM_MODEL=gpt-5.4-mini
RAGAPP_LLM_TEMPERATURE=0.0
RAGAPP_LLM_REASONING_EFFORT=none
RAGAPP_JUDGE_MODEL=gpt-5.4
RAGAPP_JUDGE_REASONING_EFFORT=none
RAGAPP_EMBEDDING_MODEL=text-embedding-3-small
RAGAPP_QDRANT_URL=http://localhost:6335
RAGAPP_QDRANT_COLLECTION=university_policy_corpus

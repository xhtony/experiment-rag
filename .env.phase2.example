RAGAPP_CHUNK_SIZE=800
RAGAPP_CHUNK_OVERLAP=120
RAGAPP_TOP_K=5
RAGAPP_CANDIDATE_K=20
RAGAPP_RRF_K=60
RAGAPP_C3_MAX_RETRIES=1
RAGAPP_MAX_CONTEXT_CHARS=12000
